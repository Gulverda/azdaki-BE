PORT=3000
# ლოკალურად ორივე ერთნაირია. Supabase-ზე:
#   DATABASE_URL → Transaction pooler (პორტი 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   → Session pooler / Direct connection (პორტი 5432)
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/azdaki?schema=public"
DIRECT_URL="postgresql://postgres:PASSWORD@localhost:5432/azdaki?schema=public"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# მძიმით გამოყოფილი, მაგ.: http://localhost:5173,https://azdaki.ge
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
# seed-ისთვის — პირველი ადმინის ანგარიში
ADMIN_EMAIL=admin@azdaki.ge
ADMIN_PASSWORD=change-me
# ადმინპანელის cookie session
SESSION_SECRET=change-me-to-a-long-random-string
