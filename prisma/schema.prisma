// ორენოვნება: ყველა თარგმნად ველს აქვს `Ka` (სავალდებულო) და `En` (არასავალდებულო) ვერსია.
// საჯარო API აბრუნებს მხოლოდ ერთ ველს (`title`) მოთხოვნილ ენაზე — იხ. LocalizeInterceptor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // migration-ებისთვის — pooler-ის გვერდის ავლით, პირდაპირი კავშირი (Supabase-ზე პორტი 5432)
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model News {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  titleKa     String
  titleEn     String?
  excerptKa   String?
  excerptEn   String?
  contentKa   String
  contentEn   String?
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

enum StaffCategory {
  ACTOR
  DIRECTOR
  ARTISTIC
  ADMINISTRATION
  TECHNICAL
}

model StaffMember {
  id         Int               @id @default(autoincrement())
  nameKa     String
  nameEn     String?
  positionKa String
  positionEn String?
  bioKa      String?
  bioEn      String?
  photo      String?
  category   StaffCategory     @default(ACTOR)
  order      Int               @default(0)
  isActive   Boolean           @default(true)
  roles      PerformanceCast[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Performance {
  id                 Int                @id @default(autoincrement())
  slug               String             @unique
  titleKa            String
  titleEn            String?
  shortDescriptionKa String?
  shortDescriptionEn String?
  descriptionKa      String
  descriptionEn      String?
  authorKa           String?
  authorEn           String?
  durationMinutes    Int?
  ageRestriction     Int?
  premiereDate       DateTime?
  coverImage         String?
  trailerUrl         String?
  isPublished        Boolean            @default(false)
  order              Int                @default(0)
  images             PerformanceImage[]
  cast               PerformanceCast[]
  showtimes          Showtime[]
  galleryItems       GalleryItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model PerformanceImage {
  id            Int         @id @default(autoincrement())
  url           String
  order         Int         @default(0)
  performance   Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  performanceId Int
}

// ვინ ვის თამაშობს კონკრეტულ სპექტაკლში (ან რეჟისორი, მხატვარი და ა.შ.)
model PerformanceCast {
  id            Int         @id @default(autoincrement())
  roleKa        String?
  roleEn        String?
  order         Int         @default(0)
  performance   Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  performanceId Int
  staff         StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId       Int
}

model Showtime {
  id            Int         @id @default(autoincrement())
  startsAt      DateTime
  venueKa       String?
  venueEn       String?
  ticketUrl     String?
  performance   Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  performanceId Int

  @@index([startsAt])
}

enum MediaType {
  IMAGE
  VIDEO
}

model GalleryItem {
  id            Int          @id @default(autoincrement())
  type          MediaType
  url           String // ატვირთული ფაილი (/uploads/...) ან YouTube/Vimeo ლინკი
  thumbnail     String?
  titleKa       String?
  titleEn       String?
  order         Int          @default(0)
  performance   Performance? @relation(fields: [performanceId], references: [id], onDelete: SetNull)
  performanceId Int?
  createdAt     DateTime     @default(now())
}

// ერთადერთი ჩანაწერი (id = 1) — "ჩვენს შესახებ" გვერდის კონტენტი
model AboutPage {
  id        Int      @id @default(1)
  titleKa   String
  titleEn   String?
  contentKa String
  contentEn String?
  heroImage String?
  images    String[]
  videos    String[]
  updatedAt DateTime @updatedAt
}

// ---------- სერვისული ცხრილები (Vercel-ზე მეხსიერება instance-ებს შორის არ ზიარდება) ----------

// ადმინპანელის session-ები — connect-pg-simple-ის ფორმატი
model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// login-ის rate limit-ის მთვლელები — იხ. common/rate-limit/prisma-rate-limit.store.ts
model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime @db.Timestamptz(3)
}
